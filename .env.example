# ==============================================================================
# Automated Incident Notification Channels Configuration
# Copy this file to .env and provide your credentials.
# ==============================================================================

# 1. Telegram Bot Channel
# Create via @BotFather on Telegram, then get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Slack Incoming Webhook Channel
# Create via Slack App Directory -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# 3. Generic JSON Webhook Channel
# Standard HTTP POST JSON endpoint (e.g. custom dispatch, municipal EMS gateway)
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_SECRET=

# 4. Email (SMTP) Channel
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 5. Dispatch Rate Limiting & Cooldown
# Minimum seconds between alerts from the same camera to prevent crash spam
NOTIFICATION_COOLDOWN_SECONDS=60
